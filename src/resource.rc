		{
			MENUITEM " ", IDX_LANGUAGE
		}
		MENUITEM SEPARATOR
		MENUITEM " ", IDM_WEBSITE
		MENUITEM " ", IDM_CHECKUPDATES
		MENUITEM " ", IDM_ABOUT
		MENUITEM SEPARATOR
		MENUITEM " ", IDM_EXIT
	}
}

IDM_TRAY MENU
{
	POPUP ""
	{
		MENUITEM " ", IDM_TRAY_SHOW
		MENUITEM SEPARATOR
		MENUITEM " ", IDM_TRAY_CLEAN
