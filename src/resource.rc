	EDITTEXT		IDC_TRAYLEVELDANGER_CTRL, 208, 44, 44, 12, ES_AUTOHSCROLL | ES_NUMBER | ES_MULTILINE
	CONTROL			"", IDC_TRAYLEVELDANGER, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_HOTTRACK | UDS_SETBUDDYINT | UDS_WRAP, 0, 0, 0, 0

	LTEXT			"", IDC_TITLE_8, 12, 66, 236, 12

	LTEXT			"", IDC_TRAYACTIONSC_HINT, 12, 82, 108, 12, SS_CENTERIMAGE
	COMBOBOX		IDC_TRAYACTIONSC, 124, 82, 124, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

	LTEXT			"", IDC_TRAYACTIONMC_HINT, 12, 100, 108, 12, SS_CENTERIMAGE
	COMBOBOX		IDC_TRAYACTIONMC, 124, 100, 124, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

	LTEXT			"", IDC_TITLE_9, 12, 122, 236, 12

	AUTOCHECKBOX	"", IDC_SHOW_CLEAN_RESULT_CHK, 12, 138, 236, 12, BS_MULTILINE
	AUTOCHECKBOX	"", IDC_NOTIFICATIONSOUND_CHK, 12, 156, 236, 12, BS_MULTILINE
}

IDD_SETTINGS_ADVANCED DIALOGEX 0, 0, 260, 194
STYLE WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
