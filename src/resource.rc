		MENUITEM " ", IDM_TRAY_WEBSITE
		MENUITEM " ", IDM_TRAY_ABOUT
		MENUITEM SEPARATOR
		MENUITEM " ", IDM_TRAY_EXIT
	}
}

//
// Dialog resources
//
IDD_MAIN DIALOGEX 0, 0, 229, 176
STYLE WS_POPUPWINDOW | WS_MINIMIZEBOX | WS_CAPTION | WS_CLIPCHILDREN | DS_SHELLFONT | DS_MODALFRAME | NOT WS_VISIBLE
CAPTION APP_NAME
FONT 9, "Segoe UI"
{
	PUSHBUTTON		"", IDC_CLEAN, 9, 148, 183, 23, BS_OWNERDRAW | WS_TABSTOP
	PUSHBUTTON		"", IDC_CLEANMENU, 192, 148, 25, 23, BS_OWNERDRAW | WS_TABSTOP
	PUSHBUTTON		"", IDC_MAINMENU, 203, 7, 17, 17, BS_OWNERDRAW | WS_TABSTOP
	PUSHBUTTON		"", IDC_SETTINGS, 160, 165, 60, 9, BS_OWNERDRAW | WS_TABSTOP
}

IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 260, 194
STYLE WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
	LTEXT			"", IDC_TITLE_1, 12, 10, 236, 12

	AUTOCHECKBOX	"", IDC_ALWAYSONTOP_CHK, 12, 28, 236, 12
	AUTOCHECKBOX	"", IDC_LOADONSTARTUP_CHK, 12, 46, 236, 12
	AUTOCHECKBOX	"", IDC_STARTMINIMIZED_CHK, 12, 64, 236, 12
	AUTOCHECKBOX	"", IDC_REDUCTCONFIRMATION_CHK, 12, 82, 236, 12
	AUTOCHECKBOX	"", IDC_SKIPUACWARNING_CHK, 12, 100, 236, 12
	AUTOCHECKBOX	"", IDC_CHECKUPDATES_CHK, 12, 118, 236, 12

	LTEXT			"", IDC_TITLE_2, 12, 140, 236, 12

	LTEXT			"", IDC_LANGUAGE_HINT, 12, 158, 108, 12, SS_CENTERIMAGE
	COMBOBOX		IDC_LANGUAGE, 124, 158, 124, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
}

IDD_SETTINGS_MEMORY DIALOGEX 0, 0, 260, 194
STYLE WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
	LTEXT			"", IDC_TITLE_3, 12, 10, 236, 12

	CONTROL			"", IDC_REGIONS, WC_LISTVIEW, LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP | WS_VSCROLL, 12, 26, 236, 68

	LTEXT			"", IDC_TITLE_4, 12, 104, 236, 12

	AUTOCHECKBOX	"", IDC_AUTOREDUCTENABLE_CHK, 12, 120, 190, 12, BS_MULTILINE
	EDITTEXT		IDC_AUTOREDUCTVALUE_CTRL, 208, 120, 44, 12, ES_AUTOHSCROLL | ES_NUMBER | ES_MULTILINE
	CONTROL			"", IDC_AUTOREDUCTVALUE, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_HOTTRACK | UDS_SETBUDDYINT | UDS_WRAP, 0, 0, 0, 0

	AUTOCHECKBOX	"", IDC_AUTOREDUCTINTERVALENABLE_CHK, 12, 138, 190, 12, BS_MULTILINE
	EDITTEXT		IDC_AUTOREDUCTINTERVALVALUE_CTRL, 208, 138, 44, 12, ES_AUTOHSCROLL | ES_NUMBER | ES_MULTILINE
	CONTROL			"", IDC_AUTOREDUCTINTERVALVALUE, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_HOTTRACK | UDS_SETBUDDYINT | UDS_WRAP, 0, 0, 0, 0

	LTEXT			"", IDC_TITLE_5, 12, 160, 236, 12

	AUTOCHECKBOX	"", IDC_HOTKEY_CLEAN_CHK, 12, 176, 140, 12, BS_MULTILINE
	CONTROL			"", IDC_HOTKEY_CLEAN, HOTKEY_CLASS, WS_TABSTOP, 158, 176, 90, 12
}

IDD_SETTINGS_APPEARANCE DIALOGEX 0, 0, 260, 194
STYLE WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
	LTEXT			"", IDC_TITLE_1, 12, 8, 236, 12

	AUTOCHECKBOX	"", IDC_TRAYUSETRANSPARENCY_CHK, 12, 24, 236, 12
	AUTOCHECKBOX	"", IDC_TRAYSHOWBORDER_CHK, 12, 40, 236, 12
	AUTOCHECKBOX	"", IDC_TRAYROUNDCORNERS_CHK, 12, 56, 236, 12
	AUTOCHECKBOX	"", IDC_TRAYCHANGEBG_CHK, 12, 72, 236, 12
	AUTOCHECKBOX	"", IDC_TRAYUSEANTIALIASING_CHK, 12, 88, 236, 12

	LTEXT			"", IDC_TITLE_6, 12, 108, 236, 12

	LTEXT			"", IDC_FONT_HINT, 12, 124, 108, 14, SS_CENTERIMAGE
	PUSHBUTTON		"", IDC_FONT, 124, 124, 124, 14

	CONTROL			"", IDC_COLORS, WC_LISTVIEW, LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP | WS_VSCROLL, 12, 144, 236, 42
}

IDD_SETTINGS_TRAY DIALOGEX 0, 0, 260, 194
STYLE WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
	LTEXT			"", IDC_TITLE_7, 12, 10, 236, 12

	LTEXT			"", IDC_TRAYLEVELWARNING_HINT, 12, 26, 190, 12, SS_CENTERIMAGE
	EDITTEXT		IDC_TRAYLEVELWARNING_CTRL, 208, 26, 44, 12, ES_AUTOHSCROLL | ES_NUMBER | ES_MULTILINE
	CONTROL			"", IDC_TRAYLEVELWARNING, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_HOTTRACK | UDS_SETBUDDYINT | UDS_WRAP, 0, 0, 0, 0

